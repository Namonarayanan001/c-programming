#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* memLeak(int memory1, int memory2, int* returnSize) {
    int i = 1;
    
    while (1) {
        if (memory1 >= memory2) {
            if (memory1 >= i) {
                memory1 -= i;
            } else {
                break;
            }
        } else {
            if (memory2 >= i) {
                memory2 -= i;
            } else {
                break;
            }
        }
        i++;
    }
    
    int* result = (int*)malloc(3 * sizeof(int));
    
    *returnSize = 3;
    
    result[0] = i;
    result[1] = memory1;
    result[2] = memory2;
    
    return result;
}
