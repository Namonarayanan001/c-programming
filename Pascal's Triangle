/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be allocated, do not return responses on the stack.
 */
int** generate(int numRows, int* returnSize, int** returnColumnSizes) {
    // Set the total number of rows being returned
    *returnSize = numRows;
    
    // Allocate an array of integer pointers for the rows
    int** triangle = (int**)malloc(numRows * sizeof(int*));
    
    // Allocate an array to store the size of each row
    *returnColumnSizes = (int*)malloc(numRows * sizeof(int));
    
    for (int i = 0; i < numRows; i++) {
        // Row 'i' has exactly 'i + 1' elements
        (*returnColumnSizes)[i] = i + 1;
        
        // Allocate memory for the current row
        triangle[i] = (int*)malloc((i + 1) * sizeof(int));
        
        // Populate the elements of row 'i'
        for (int j = 0; j <= i; j++) {
            // First and last elements of any row are always 1
            if (j == 0 || j == i) {
                triangle[i][j] = 1;
            } else {
                // Middle elements are the sum of the two elements directly above
                triangle[i][j] = triangle[i - 1][j - 1] + triangle[i - 1][j];
            }
        }
    }
    
    return triangle;
}
